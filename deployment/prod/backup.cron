# Ablage: /etc/cron.d/quellwerk-backup
# Taegliche Sicherung der Datenbank um 03:20, Ausgabe ins Journal.
# Die Datei braucht eine Leerzeile am Ende, sonst ignoriert cron die letzte Zeile.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

20 3 * * * root /usr/local/bin/quellwerk-backup.sh 2>&1 | logger -t quellwerk-backup

