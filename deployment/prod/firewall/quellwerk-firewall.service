# Ablage: /etc/systemd/system/quellwerk-firewall.service
# Aktiv:  systemctl daemon-reload && systemctl enable --now quellwerk-firewall
#
# Von Hand gesetzte iptables-Regeln verschwinden beim Reboot. Diese Unit setzt
# sie nach dem Docker-Daemon neu; das Skript ist wiederholbar, weil es jede Regel
# vorher mit `iptables -C` prueft.
[Unit]
Description=Quellwerk container network firewall rules
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/quellwerk-firewall.sh

[Install]
WantedBy=multi-user.target
