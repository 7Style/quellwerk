# ==============================================================================
# bp-monolith - Compose-Variablen (.env im Repo-Root)
# ==============================================================================
# Gelesen von docker-compose.yml und deployment/*/docker/docker-compose.yml
# (dort mit --env-file .env). Anwendungs-Einstellungen des Backends stehen in
# backend/.env (Vorlage backend/example.env), nicht hier.
#
# Passwörter haben keine Defaults: bleibt ein Wert leer, bricht Compose ab.
# ==============================================================================

# PostgreSQL (Container "db" bzw. "postgres")
POSTGRES_USER=bp_user
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=bp_monolith

# Redis (Container "redis", --requirepass)
# openssl rand -hex 24
REDIS_PASSWORD=

# Anzeigename und Beschreibung (Backend: APP_NAME/APP_DESCRIPTION; Frontend:
# NEXT_PUBLIC_APP_NAME/NEXT_PUBLIC_APP_DESCRIPTION als Build-Args)
APP_NAME=bp-monolith
APP_DESCRIPTION=

# Origin des Backends, wie der Browser es erreicht, ohne /api-Suffix.
# Wird beim Frontend-Build eingebrannt (Build-Arg); nach Änderung Image neu bauen.
# Lokal: http://localhost:3011, hinter Nginx: https://<domain>
NEXT_PUBLIC_API_URL=http://localhost:3011

# Seed beim Containerstart (nur ausserhalb von production, siehe
# backend/docker-entrypoint.sh). Für Compose kommen ALLE Seed-Werte aus dieser
# Datei; SEED_*-Werte in backend/.env sind im Container wirkungslos.
# Leer = nicht gesetzt (Default für SEED_ADMIN_EMAIL: admin@bp-monolith.local).
SEED_ON_START=false
# SEED_ADMIN_EMAIL=admin@bp-monolith.local
# Pflicht sobald SEED_ON_START=true, min. 12 Zeichen
# SEED_ADMIN_PASSWORD=
# Demo-Konten moderator@/user@/inactive@<Domain von SEED_ADMIN_EMAIL>
# (Voraussetzung für die e2e-Tests, siehe e2e/.env.example)
# SEED_DEMO_USERS=true
# SEED_DEMO_PASSWORD=

# --- deployment/dev und deployment/prod (Nginx mit Let's Encrypt) --------------
# LETSENCRYPT_EMAIL=
# DEV_DOMAIN=bp-dev.7style.net
# PROD_DOMAIN=bp-prod.7style.net
# LOCAL_DOMAIN=bp-local.7style.net

# --- deployment/prod-native (network_mode: host) ------------------------------
# BACKEND_PORT=3011
# FRONTEND_PORT=3000
