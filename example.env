# ==============================================================================
# quellwerk - Compose-Variablen (.env im Repo-Root)
# ==============================================================================
# Gelesen von docker-compose.yml und deployment/*/docker/docker-compose.yml
# (dort mit --env-file .env). Anwendungs-Einstellungen des Backends stehen in
# backend/.env (Vorlage backend/example.env), nicht hier.
#
# Passwörter haben keine Defaults: bleibt ein Wert leer, bricht Compose ab.
# ==============================================================================

# PostgreSQL (Container "db" bzw. "postgres")
POSTGRES_USER=quellwerk_user
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=quellwerk

# Redis (Container "redis", --requirepass)
# openssl rand -hex 24
REDIS_PASSWORD=

# Anzeigename und Beschreibung (Backend: APP_NAME/APP_DESCRIPTION; Frontend:
# NEXT_PUBLIC_APP_NAME/NEXT_PUBLIC_APP_DESCRIPTION als Build-Args)
APP_NAME=quellwerk
APP_DESCRIPTION=

# Origin des Backends, wie der Browser es erreicht, ohne /api-Suffix.
# Wird beim Frontend-Build eingebrannt (Build-Arg); nach Änderung Image neu bauen.
# Lokal: http://localhost:3011, hinter Nginx: https://<domain>
NEXT_PUBLIC_API_URL=http://localhost:3011

# Seed beim Containerstart (nur ausserhalb von production, siehe
# backend/docker-entrypoint.sh). Das Demo-Notizbuch mit der festen id "demo"
# entsteht ab M2-T5 aus backend/evals/corpus/; die Konten-Variablen der Vorlage
# sind mit dem Kontosystem entfallen.
SEED_ON_START=false

# --- nur fuer deployment/prod ------------------------------------------------
# Der Name, unter dem die Seite erreichbar ist, ohne Schema. Compose baut daraus
# PUBLIC_URL, CORS_ORIGIN, FRONTEND_URL, API_URL und das Build-Arg des
# Frontends. Lokal wird der Wert nicht gebraucht; fehlt er auf dem Server,
# bricht compose mit "PROD_DOMAIN fehlt" ab, bevor etwas startet.
PROD_DOMAIN=
