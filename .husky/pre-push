# Husky 9 runs this file with `sh -e` (see .husky/_/h); keep it POSIX sh.
# Runs from the repository root.

RED=$(printf '\033[0;31m')
GREEN=$(printf '\033[0;32m')
YELLOW=$(printf '\033[1;33m')
NC=$(printf '\033[0m')

# run LABEL CMD...: run CMD and show its output only when it fails.
# The `if` checks the exit status of CMD itself (never of a grep/tail
# pipeline) and keeps `sh -e` from aborting before the output is printed.
run() {
    label=$1
    shift
    printf '  ... %s\n' "$label"
    if out=$("$@" 2>&1); then
        printf '  %s\n' "${GREEN}OK: $label${NC}"
    else
        status=$?
        printf '%s\n' "$out"
        printf '  %s\n' "${RED}FAILED: $label (exit $status). Fix the errors above before pushing.${NC}"
        exit 1
    fi
}

printf 'Running pre-push checks (full build validation)...\n'

printf '%s\n' "${YELLOW}Backend checks...${NC}"
run "[1/4] Prisma validate"    pnpm --filter @quellwerk/backend exec prisma validate
run "[2/4] Prisma generate"    pnpm --filter @quellwerk/backend exec prisma generate
run "[3/4] Backend TypeScript" pnpm --filter @quellwerk/backend exec tsc --noEmit
run "[4/4] Backend build"      pnpm --filter @quellwerk/backend run build

printf '%s\n' "${YELLOW}Frontend checks...${NC}"
run "[1/2] Frontend TypeScript" pnpm --filter @quellwerk/frontend exec tsc --noEmit
run "[2/2] Frontend build"      pnpm --filter @quellwerk/frontend run build

printf '%s\n' "${GREEN}All pre-push checks passed. Safe to push.${NC}"
