# Husky 9 runs this file with `sh -e` (see .husky/_/h); keep it POSIX sh.
# Runs from the repository root.

RED=$(printf '\033[0;31m')
GREEN=$(printf '\033[0;32m')
YELLOW=$(printf '\033[1;33m')
NC=$(printf '\033[0m')

# run LABEL CMD...: run CMD and show its output only when it fails.
# The `if` checks the exit status of CMD itself (never of a grep/tail
# pipeline) and keeps `sh -e` from aborting before the output is printed.
run() {
    label=$1
    shift
    printf '  ... %s\n' "$label"
    if out=$("$@" 2>&1); then
        printf '  %s\n' "${GREEN}OK: $label${NC}"
    else
        status=$?
        printf '%s\n' "$out"
        printf '  %s\n' "${RED}FAILED: $label (exit $status)${NC}"
        exit 1
    fi
}

printf 'Running pre-commit checks...\n'

STAGED_BACKEND=$(git diff --cached --name-only --diff-filter=ACMR | grep '^backend/.*\.ts$' || true)
STAGED_FRONTEND=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^frontend/.*\.(ts|tsx)$' || true)

if [ -n "$STAGED_BACKEND" ]; then
    printf '%s\n' "${YELLOW}Backend changes staged - running checks...${NC}"
    # Prisma Client first, so tsc never sees stale @prisma/client types.
    run "Prisma generate"     pnpm --filter @quellwerk/backend exec prisma generate
    run "Backend TypeScript"  pnpm --filter @quellwerk/backend exec tsc --noEmit
    run "Prisma validate"     pnpm --filter @quellwerk/backend exec prisma validate
fi

if [ -n "$STAGED_FRONTEND" ]; then
    printf '%s\n' "${YELLOW}Frontend changes staged - running checks...${NC}"
    run "Frontend TypeScript" pnpm --filter @quellwerk/frontend exec tsc --noEmit
fi

# --------------------------------------------------------------------------
# Security checks on the staged files (compose ports/socket/passwords, CORS
# wildcard, secret fallbacks, tracked .env, workflow injection). The script
# reads the Git index in --staged mode and ignores comment lines.
# --------------------------------------------------------------------------
run "Security check (staged)" bash scripts/security-check.sh --staged

printf '%s\n' "${GREEN}All pre-commit checks passed.${NC}"
