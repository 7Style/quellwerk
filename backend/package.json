{
  "name": "@quellwerk/backend",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "dev": "tsx watch app/server.ts",
    "start": "node dist/app/server.js",
    "build": "prisma generate && tsc -p .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "prisma migrate dev && prisma generate && prisma db seed"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.2",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "pdfjs-dist": "^6.3.289",
    "prisma": "7.10.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "catalog:",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0"
  }
}
