# ==============================================================================
# BACKEND CONFIGURATION (copy to backend/.env)
#
# Every variable is validated at start-up in app/config/env.config.ts.
# Secrets have NO fallbacks: the server refuses to start without them.
# An empty value (KEY=) counts as "not set".
# Generate secrets with:  openssl rand -hex 32
#
# Werte aus docker-compose überschreiben diese Datei: im Container gewinnt der
# `environment`-Block der Compose-Datei gegen diese env_file. Dort werden aus
# der Root-.env gesetzt: NODE_ENV, PORT, APP_NAME, DATABASE_URL, REDIS_URL,
# UPLOAD_DIR, SEED_ON_START, SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD,
# SEED_DEMO_USERS, SEED_DEMO_PASSWORD (prod-native zusätzlich HOST). Die Werte
# hier gelten dafür nur auf dem Host (`pnpm dev`, `prisma db seed`).
# ==============================================================================

# ------------------------------------------------------------------------------
# APP
# ------------------------------------------------------------------------------
APP_NAME=bp-monolith
APP_DESCRIPTION=
NODE_ENV=development
PORT=3011
# Interface des HTTP-Servers (Default 0.0.0.0; prod-native setzt 127.0.0.1)
# HOST=0.0.0.0
# Public URL of this API (used for upload links); BASE_URL overrides it
API_URL=http://localhost:3011
# Frontend origin (email links, CORS allowlist)
FRONTEND_URL=http://localhost:3010

# ------------------------------------------------------------------------------
# DATABASE / REDIS (required). On the host (`docker compose up -d db redis`) the
# credentials are POSTGRES_USER/POSTGRES_PASSWORD and REDIS_PASSWORD from the
# root .env; the placeholders below are deliberately not valid URLs.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://bp_user:<POSTGRES_PASSWORD>@localhost:5432/bp_monolith
# Redis backs the rate limiters and the /health check
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# ------------------------------------------------------------------------------
# SECRETS (required, at least 32 characters each, never commit real values)
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
# Key for encrypting 2FA secrets and other data at rest
ENCRYPTION_KEY=
# Optional and unused (auth is JWT, express-session was removed); if set, 32+ characters
# SESSION_SECRET=

# ------------------------------------------------------------------------------
# AUTH / JWT
# ------------------------------------------------------------------------------
# Access tokens are short-lived, refresh tokens rotate every 7 days
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=bp-monolith
JWT_AUDIENCE=bp-monolith-api
SESSION_MAX_AGE=86400000
# Single source of truth for the bcrypt cost (passwords, backup codes, seeds)
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# CORS (comma separated allowlist; localhost dev ports are added in development)
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3010

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_2FA_MAX=5
# Comma separated IPs that bypass rate limiting (monitoring)
RATE_LIMIT_TRUSTED_IPS=

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d

# ------------------------------------------------------------------------------
# EMAIL (console = log only; smtp needs SMTP_HOST, brevo needs BREVO_API_KEY)
# Details: backend/app/services/email/README.md
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=console
# Sender name defaults to APP_NAME
# EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=noreply@example.com
SUPPORT_EMAIL=support@example.com
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS on 587 (enforced), true = implicit TLS on 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Only with EMAIL_PROVIDER=brevo (sender defaults to EMAIL_FROM_*, template IDs 1-7)
# BREVO_API_KEY=
# BREVO_API_URL=https://api.brevo.com/v3
# BREVO_SENDER_NAME=
# BREVO_SENDER_EMAIL=
# BREVO_TEMPLATE_PASSWORD_RESET=1
# BREVO_TEMPLATE_EMAIL_VERIFY=2
# BREVO_TEMPLATE_ACCOUNT_LOCKED=3
# BREVO_TEMPLATE_2FA=4
# BREVO_TEMPLATE_WELCOME=5
# BREVO_TEMPLATE_2FA_ENABLED=6
# BREVO_TEMPLATE_2FA_DISABLED=7
# Optional: subjects (default: "<text> - APP_NAME"), console echo, previews, per-hour limits
# EMAIL_SUBJECT_PASSWORD_RESET=
# EMAIL_SUBJECT_EMAIL_VERIFICATION=
# EMAIL_SUBJECT_ACCOUNT_LOCKED=
# EMAIL_SUBJECT_2FA_CODE=
# EMAIL_SUBJECT_OTP_CODE=
# EMAIL_SUBJECT_WELCOME=
# EMAIL_SUBJECT_2FA_ENABLED=
# EMAIL_SUBJECT_2FA_DISABLED=
# EMAIL_SUBJECT_CUSTOM=
# EMAIL_LOG_TO_CONSOLE=false
# EMAIL_PREVIEW=false
# EMAIL_RATE_LIMIT_PER_USER=10
# EMAIL_RATE_LIMIT_TOTAL=1000

# ------------------------------------------------------------------------------
# FILE UPLOAD
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
HELMET_CSP_ENABLED=true
COMPRESSION_ENABLED=true
# Proxy hops whose X-Forwarded-For is trusted: 1 behind the nginx of
# deployment/*, 0 when clients reach the backend directly (else a client can
# choose its own IP for rate limits and audit logs)
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# AUDIT
# ------------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=365

# ------------------------------------------------------------------------------
# SEEDS (prisma db seed on the host; refused when NODE_ENV=production)
# In docker compose these come from the root .env (see header); the seed there
# runs only with SEED_ON_START=true.
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@bp-monolith.local
# Required to seed the SUPER_ADMIN account (min 12 characters)
# SEED_ADMIN_PASSWORD=
# Optional demo accounts moderator@/user@/inactive@<domain of SEED_ADMIN_EMAIL>
# with a shared password (the e2e tests need them, see e2e/.env.example)
SEED_DEMO_USERS=false
# SEED_DEMO_PASSWORD=
