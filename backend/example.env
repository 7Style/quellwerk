# ==============================================================================
# Quellwerk backend configuration. Copy to backend/.env and fill in the values
# marked as required; that file is written by hand and never by the agent.
#
# The only module that reads process.env is app/config/env.config.ts. A value
# that is empty counts as missing, and a missing required value stops the start.
#
# Under docker compose, DATABASE_URL, REDIS_URL, PORT, NODE_ENV, APP_NAME,
# UPLOAD_DIR and SEED_ON_START are set in docker-compose.yml and win against
# this file: `environment` beats `env_file`.
# ==============================================================================

# ------------------------------------------------------------------------------
# APP
# ------------------------------------------------------------------------------
APP_NAME=Quellwerk
APP_DESCRIPTION=
NODE_ENV=development
PORT=3011
HOST=0.0.0.0
API_URL=http://localhost:3011
FRONTEND_URL=http://localhost:3010
# Public origin behind nginx, used for links that leave the process
# PUBLIC_URL=https://quellwerk.example.net
# Base URL for stored file links; defaults to API_URL when unset
# BASE_URL=

# ------------------------------------------------------------------------------
# DATA STORES (required). On the host, start db and redis with
# `docker compose up -d db redis` and keep these pointing at 127.0.0.1.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://quellwerk_user:<POSTGRES_PASSWORD>@localhost:5432/quellwerk
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# ------------------------------------------------------------------------------
# SECRETS (required, never committed with a real value)
#   openssl rand -hex 32
# ------------------------------------------------------------------------------
# Signs the anonymous session cookie, 32+ characters
SESSION_SECRET=
# The only external call this application makes
ANTHROPIC_API_KEY=
# Guards /api/admin/stats, 16+ characters
ADMIN_TOKEN=
# Optional, only for the audio overview (M10)
# GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# SESSION (anonymous, no accounts; ADR-0005)
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME=qw.sid
# 30 days
SESSION_MAX_AGE=2592000000

# ------------------------------------------------------------------------------
# MODELS (ADR-0011). Ids live here and nowhere else in the code.
# MODEL_CHAT=claude-sonnet-5 is the one-line switch when latency or cost matters
# more than answer quality; then set MODEL_JUDGE to a different model.
# ------------------------------------------------------------------------------
MODEL_CHAT=claude-opus-5
MODEL_FAST=claude-haiku-4-5
MODEL_JUDGE=claude-sonnet-5
# One effort for chat and reports: they share a cache namespace (ADR-0007)
EFFORT_CHAT=low

# ------------------------------------------------------------------------------
# BUDGET. Configured in cents; usage_log stores micro-cents and the comparison
# multiplies the cap by 1_000_000.
# ------------------------------------------------------------------------------
DAILY_SPEND_CAP_CENTS=500
EVAL_SPEND_CAP_CENTS=1000
# Answer from recorded fixtures instead of the API (keeps the demo alive without
# a key or after the budget is spent)
DEMO_OFFLINE=false

# ------------------------------------------------------------------------------
# CAPS (docs/SPEC.md, "Zahlen")
# ------------------------------------------------------------------------------
MAX_SOURCES_PER_NOTEBOOK=50
MAX_TOKENS_PER_NOTEBOOK=150000
MAX_QUESTION_CHARS=4000
RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# CORS. Comma separated; the frontend origin as the browser sees it.
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3010

# ------------------------------------------------------------------------------
# RATE LIMITS (SECURITY.md 7.3)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_CHAT_PER_SESSION=30
RATE_LIMIT_CHAT_PER_IP=60
RATE_LIMIT_ARTIFACTS_PER_SESSION=10
RATE_LIMIT_SOURCES_PER_SESSION=20
# Comma separated, exempt from the limiters (CI runners)
RATE_LIMIT_TRUSTED_IPS=

# ------------------------------------------------------------------------------
# LOGGING. Logs carry ids and lengths, never source text, questions or answers.
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d

# ------------------------------------------------------------------------------
# UPLOADS (SECURITY.md 7.4). 20 MB per file; the type is checked against the
# content, not only against the declared content type.
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=20971520
UPLOAD_ALLOWED_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ------------------------------------------------------------------------------
# HTTP
# ------------------------------------------------------------------------------
HELMET_CSP_ENABLED=true
COMPRESSION_ENABLED=true
# Proxy hops whose X-Forwarded-For is trusted (1 = nginx)
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# SEED. The demo notebook with the fixed id "demo" arrives in M2-T5.
# ------------------------------------------------------------------------------
SEED_ON_START=false
