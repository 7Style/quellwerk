{
  // Was in das Produktions-Image geht. Die Basis-Konfiguration nimmt evals/ und
  // scripts/ mit auf, damit eslint und `tsc --noEmit` beide pruefen; gebaut
  // wird keins von beiden. Der Backend-Container kopiert dist/ als Ganzes, und
  // ein Harness, das Fragen an ein Modell stellt, hat in einem Produktions-Image
  // nichts zu suchen. Braucht ein Skript spaeter einen Platz im Image (M8-T1,
  // demo-reset), wird das hier entschieden und nicht nebenbei.
  "extends": "./tsconfig.json",
  "include": ["app/**/*", "prisma/**/*", "prisma.config.ts"]
}
