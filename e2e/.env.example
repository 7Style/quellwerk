# ==============================================================================
# e2e/.env (optional; copy this file, it is loaded by playwright.config.ts)
# ==============================================================================

# Frontend under test (Playwright baseURL)
BASE_URL=http://localhost:3010

# The same variables the backend seed reads (backend/example.env on the host,
# root example.env for docker compose). The fixtures derive the accounts from
# them: admin = SEED_ADMIN_EMAIL, demo accounts moderator@/user@<its domain>.
SEED_ADMIN_EMAIL=admin@bp-monolith.local
SEED_ADMIN_PASSWORD=
# Demo accounts exist only when the seed ran with SEED_DEMO_USERS=true;
# specs that need them skip with a message unless this is true.
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=

# Optional overrides, take precedence over the SEED_* values above
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_MODERATOR_EMAIL=
# TEST_MODERATOR_PASSWORD=
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=

# ------------------------------------------------------------------------------
# Login rate limiter of the backend under test (set in backend/.env, NOT read
# by Playwright). The backend counts failed POST /api/auth/login per IP:
# RATE_LIMIT_LOGIN_MAX (default 5) within RATE_LIMIT_WINDOW_MS (default 15 min);
# successful logins are not counted. The suite runs on one worker and each
# auth spec file sends at most 4 failed logins, so a single run fits into the
# default. For repeated runs within 15 minutes (or Playwright retries) raise
# the limit for the test target or exempt the test client's IP -- the address
# the backend sees, in the compose stack the gateway of the internal network
# (docker network inspect <project>_internal). Restart the backend afterwards.
#   RATE_LIMIT_LOGIN_MAX=100
#   RATE_LIMIT_TRUSTED_IPS=172.18.0.1
