# BP Monolith Frontend - Development Dockerfile (hot reload via `next dev`)
#
# Build context is the REPO ROOT (the frontend is a package of the pnpm workspace):
#   docker build -f frontend/Dockerfile.dev -t bp-frontend-dev .
# Ignore rules live in the root .dockerignore.
# Mount ./frontend to /app/frontend for live reload; keep /app/node_modules and
# /app/frontend/node_modules as container volumes (they are pnpm symlink trees).
FROM node:24-alpine

ENV HUSKY=0 \
    NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1 \
    PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"

# Corepack is no longer bundled from Node 25 on; pin pnpm explicitly (must match packageManager).
RUN npm install -g pnpm@11.26.0

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 -G nodejs

WORKDIR /app

COPY --chown=nextjs:nodejs package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=nextjs:nodejs frontend/package.json ./frontend/

RUN pnpm install --frozen-lockfile --filter bp-monolith-frontend... && \
    chown -R nextjs:nodejs /app

COPY --chown=nextjs:nodejs frontend ./frontend

USER nextjs

WORKDIR /app/frontend

EXPOSE 3000

CMD ["pnpm", "dev"]
